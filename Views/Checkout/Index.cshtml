@model CheckoutViewModel
@{ ViewData["Title"] = "Checkout"; }
<section class="auth-page"><div class="auth-panel checkout-panel"><p class="eyebrow">ALMOST THERE</p><h1>Checkout.</h1><form asp-action="Index" method="post"><div asp-validation-summary="All" class="validation-summary"></div><label>Nombre completo<input asp-for="CustomerName" required /></label><label>Teléfono de contacto<input asp-for="PhoneNumber" type="tel" inputmode="numeric" required /></label><label>Dirección de envío<input asp-for="ShippingAddress" required /></label><label>Ciudad<input asp-for="City" required /></label><label>Notas adicionales<textarea asp-for="Notes" rows="3" placeholder="Detalles de entrega, horario, color, etc."></textarea></label><label>Método de pago<select asp-for="PaymentMethod"><option value="Nequi">Nequi</option><option value="Daviplata">Daviplata</option><option value="Efectivo">Efectivo</option></select></label><button class="button button-dark" type="submit">Enviar pedido por WhatsApp <span>↗</span></button></form></div></section>
@section Scripts { <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script><script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script> }
