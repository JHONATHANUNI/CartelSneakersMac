@model IEnumerable<Product>
@{ ViewData["Title"] = "Admin"; }
<section class="cart-page"><div class="section-heading"><div><p class="eyebrow">CONTROL ROOM</p><h1>Products.</h1></div><a href="/account/logout">Log out</a></div><form class="admin-form" asp-action="Create" method="post"><input name="Name" placeholder="Product name" required /><input name="Brand" placeholder="Brand" required /><input name="Price" type="number" step=".01" placeholder="Price" required /><input name="ImageUrl" placeholder="image.jpg" required /><input name="ImageUrl2" placeholder="hover.jpg" /><input name="Description" placeholder="Short description" /><button class="button button-dark" type="submit">Add product <span>↗</span></button></form><div class="admin-table">@foreach (var product in Model) {<div><span><strong>@product.Name</strong><small>@product.Brand / ₹@product.Price.ToString("N0")</small></span><form asp-action="Delete" method="post"><input type="hidden" name="id" value="@product.Id" /><button class="remove" type="submit">Delete</button></form></div>}</div></section>