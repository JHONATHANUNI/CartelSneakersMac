@model List<CartItem>
@{ ViewData["Title"] = "Your bag"; }
<section class="cart-page"><div class="section-heading"><div><p class="eyebrow">YOUR SELECTION</p><h1>Your bag.</h1></div><span>@Model.Sum(x => x.Quantity) items</span></div>@if (Model.Count == 0) { <div class="empty-state"><h2>Your bag is waiting.</h2><a class="button button-dark" asp-controller="Home" asp-action="Index">Shop sneakers <span>↗</span></a></div> } else { <div class="cart-layout"><div class="cart-list">@foreach (var item in Model) {<article class="cart-item"><img src="~/images/@item.ImageUrl" alt="@item.Name" /><div class="cart-item-info"><p class="product-brand">@item.Size</p><h3>@item.Name</h3><p>₹@item.UnitPrice.ToString("N0")</p></div><form asp-action="Update" method="post"><input type="hidden" name="id" value="@item.ProductId" /><input type="hidden" name="size" value="@item.Size" /><input name="quantity" type="number" min="1" max="20" value="@item.Quantity" /><button type="submit">Update</button></form><form asp-action="Remove" method="post"><input type="hidden" name="id" value="@item.ProductId" /><input type="hidden" name="size" value="@item.Size" /><button class="remove" type="submit">Remove</button></form></article>}</div><aside class="summary"><p class="eyebrow">SUMMARY</p><div><span>Subtotal</span><strong>₹@Model.Sum(x => x.Total).ToString("N0")</strong></div><a class="button button-dark" asp-controller="Checkout" asp-action="Index">Checkout <span>↗</span></a></aside></div> }</section>
