@model IEnumerable<Product>
@{
    ViewData["Title"] = "Sneakers for the next move";
    var isFiltered = !string.IsNullOrWhiteSpace(ViewBag.Brand as string);
    var brandGroups = Model
        .GroupBy(p => p.Brand)
        .Select(g => new { Brand = g.Key, Products = g.OrderBy(p => p.Id).Take(4).ToList() })
        .OrderBy(g => g.Brand)
        .ToList();
}
<section class="hero" style="background-image:linear-gradient(rgba(23,23,23,.55),rgba(23,23,23,.55)),url('/images/cartel-hero.png');"><div><p class="eyebrow">CARTEL SNEAKERS / 2026 COLLECTION</p><h1>Move different.</h1><p class="hero-copy">Curated sneakers for the city, the court and everywhere in between.</p><a class="button button-light" href="#products">Explore collection <span>↘</span></a></div><div class="hero-mark">01<br /><em>DROP</em></div></section>
@if (isFiltered)
{
    <section class="shop-section" id="products">
        <div class="section-heading">
            <div><p class="eyebrow">THE EDIT</p><h2>@ViewBag.Brand</h2></div>
            <div class="filters">
                <a class="@(ViewBag.Sort == "low" ? "active" : "")" asp-route-brand="@ViewBag.Brand" asp-route-sort="low">Price ↑</a>
                <a class="@(ViewBag.Sort == "high" ? "active" : "")" asp-route-brand="@ViewBag.Brand" asp-route-sort="high">Price ↓</a>
            </div>
        </div>
        <div class="product-grid">
            @foreach (var product in Model)
            {
                <article class="product-card">
                    <a asp-action="Product" asp-route-id="@product.Id" class="product-image">
                        <img src="~/images/@product.ImageUrl" alt="@product.Name" />
                        <img class="product-hover" src="~/images/@product.ImageUrl2" alt="" />
                    </a>
                    <div class="product-meta">
                        <div>
                            <p class="product-brand">@product.Brand</p>
                            <h3><a asp-action="Product" asp-route-id="@product.Id">@product.Name</a></h3>
                        </div>
                        <strong>$@product.Price.ToString("N0")</strong>
                    </div>
                </article>
            }
        </div>
    </section>
}
else
{
    <section class="shop-section" id="products">
        <div class="section-heading">
            <div><p class="eyebrow">THE EDIT</p><h2>All sneakers</h2></div>
            <div class="filters">
                <a class="@(ViewBag.Sort == "low" ? "active" : "")" asp-route-sort="low">Price ↑</a>
                <a class="@(ViewBag.Sort == "high" ? "active" : "")" asp-route-sort="high">Price ↓</a>
            </div>
        </div>

        <div class="brand-sections">
            @foreach (var group in brandGroups)
            {
                <section class="brand-section">
                    <div class="brand-section-head">
                        <h3>@group.Brand</h3>
                        <a asp-controller="Home" asp-action="Index" asp-route-brand="@group.Brand">Ver marca</a>
                    </div>
                    <div class="product-grid compact">
                        @foreach (var product in group.Products)
                        {
                            <article class="product-card">
                                <a asp-action="Product" asp-route-id="@product.Id" class="product-image">
                                    <img src="~/images/@product.ImageUrl" alt="@product.Name" />
                                    <img class="product-hover" src="~/images/@product.ImageUrl2" alt="" />
                                </a>
                                <div class="product-meta">
                                    <div>
                                        <p class="product-brand">@product.Brand</p>
                                        <h3><a asp-action="Product" asp-route-id="@product.Id">@product.Name</a></h3>
                                    </div>
                                    <strong>$@product.Price.ToString("N0")</strong>
                                </div>
                            </article>
                        }
                    </div>
                </section>
            }
        </div>
    </section>
}

