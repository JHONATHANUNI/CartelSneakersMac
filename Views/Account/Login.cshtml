@model LoginViewModel
@{ ViewData["Title"] = "Login"; }
<section class="auth-page"><div class="auth-panel"><p class="eyebrow">WELCOME BACK</p><h1>Sign in.</h1><form asp-action="Login" method="post"><div asp-validation-summary="All" class="validation"></div><label>Username<input asp-for="Username" required /></label><label>Password<input asp-for="Password" type="password" required /></label><button class="button button-dark" type="submit">Continue <span>↗</span></button></form><p class="form-note">New here? <a asp-action="Register">Create an account</a></p></div></section>
