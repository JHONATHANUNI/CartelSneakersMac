@model RegisterViewModel
@{ ViewData["Title"] = "Create account"; }
<section class="auth-page"><div class="auth-panel"><p class="eyebrow">JOIN THE MOVEMENT</p><h1>Create account.</h1><form asp-action="Register" method="post"><div asp-validation-summary="All" class="validation"></div><label>Username<input asp-for="Username" required /></label><div class="form-row"><label>First name<input asp-for="FirstName" required /></label><label>Last name<input asp-for="LastName" required /></label></div><label>Email<input asp-for="Email" type="email" required /></label><label>Password<input asp-for="Password" type="password" required /></label><button class="button button-dark" type="submit">Create account <span>↗</span></button></form></div></section>
